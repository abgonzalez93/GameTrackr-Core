{
  "compilerOptions": {
    "types": ["compression", "cors", "express", "node"],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@clients/*": ["clients/*"],
      "@constants/*": ["constants/*"],
      "@errors/*": ["errors/*"],
      "@i18n/*": ["i18n/*"],
      "@logger/*": ["logger/*"],
      "@middlewares/*": ["middlewares/*"],
      "@ports/*": ["ports/*"],
      "@schemas/*": ["schemas/*"],
      "@server/*": ["server/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
