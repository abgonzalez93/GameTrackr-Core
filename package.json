{
  "type": "module",
  "name": "@trackplay/core",
  "author": "Antonio Bueno Gonzalez",
  "version": "0.2.4",
  "private": false,
  "imports": {
    "#clients/*": "./src/clients/*.ts",
    "#config/*": "./src/config/*.ts",
    "#constants/*": "./src/constants/*.ts",
    "#errors/*": "./src/errors/*.ts",
    "#i18n/*": "./src/i18n/*.ts",
    "#logger/*": "./src/logger/*.ts",
    "#middlewares/*": "./src/middlewares/*.ts",
    "#ports/*": "./src/ports/*.ts",
    "#schemas/*": "./src/schemas/*.ts",
    "#server/*": "./src/server/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "exports": {
    "./clients/*": {
      "import": "./dist/clients/*.js",
      "types": "./dist/clients/*.d.ts"
    },
    "./config/*": {
      "import": "./dist/config/*.js",
      "types": "./dist/config/*.d.ts"
    },
    "./constants/*": {
      "import": "./dist/constants/*.js",
      "types": "./dist/constants/*.d.ts"
    },
    "./errors/*": {
      "import": "./dist/errors/*.js",
      "types": "./dist/errors/*.d.ts"
    },
    "./i18n/*": {
      "import": "./dist/i18n/*.js",
      "types": "./dist/i18n/*.d.ts"
    },
    "./logger/*": {
      "import": "./dist/logger/*.js",
      "types": "./dist/logger/*.d.ts"
    },
    "./middlewares/*": {
      "import": "./dist/middlewares/*.js",
      "types": "./dist/middlewares/*.d.ts"
    },
    "./ports/*": {
      "import": "./dist/ports/*.js",
      "types": "./dist/ports/*.d.ts"
    },
    "./schemas/*": {
      "import": "./dist/schemas/*.js",
      "types": "./dist/schemas/*.d.ts"
    },
    "./server/*": {
      "import": "./dist/server/*.js",
      "types": "./dist/server/*.d.ts"
    },
    "./types/*": {
      "import": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "madge": "madge --circular dist/",
    "update": "ncu -u -e 2 && pnpm install",
    "release": "pnpm build && pnpm pack && pnpm publish --tag latest --no-git-checks"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "i18next": "^25.5.3",
    "redis": "^5.8.3",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@10.18.1"
}
