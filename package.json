{
  "type": "module",
  "name": "@trackplay/core",
  "author": "Antonio Bueno Gonzalez",
  "version": "0.5.1",
  "private": false,
  "imports": {
    "#clients/*": "./dist/clients/*.js",
    "#config/*": "./dist/config/*.js",
    "#constants/*": "./dist/constants/*.js",
    "#errors/*": "./dist/errors/*.js",
    "#i18n/*": "./dist/i18n/*.js",
    "#logger/*": "./dist/logger/*.js",
    "#ports/*": "./dist/ports/*.js",
    "#schemas/*": "./dist/schemas/*.js",
    "#types/*": "./dist/types/*.js",
    "#utils/*": "./dist/utils/*.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "eslint src",
    "release": "pnpm build && rm -f trackplay-core-*.tgz && pnpm pack && pnpm publish --tag latest --no-git-checks"
  },
  "dependencies": {
    "i18next": "^25.6.0",
    "jose": "^6.1.0",
    "redis": "^5.9.0",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "packageManager": "pnpm@10.19.0"
}
