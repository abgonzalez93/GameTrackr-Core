{
  "type": "module",
  "name": "@trackplay/core",
  "author": "Antonio Bueno Gonzalez",
  "version": "0.6.0",
  "private": false,
  "main": "./dist/index.js",
  "imports": {
    "#clients/*": {
      "development": "./src/clients/*.ts",
      "default": "./dist/clients/*.js"
    },
    "#config/*": {
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#constants/*": {
      "development": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    },
    "#errors/*": {
      "development": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "#i18n/*": {
      "development": "./src/i18n/*.ts",
      "default": "./dist/i18n/*.js"
    },
    "#logger/*": {
      "development": "./src/logger/*.ts",
      "default": "./dist/logger/*.js"
    },
    "#schemas/*": {
      "development": "./src/schemas/*.ts",
      "default": "./dist/schemas/*.js"
    },
    "#types/*": {
      "development": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "#utils/*": {
      "development": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "eslint src",
    "release": "pnpm build && rm -f trackplay-core-*.tgz && pnpm pack && pnpm publish --tag latest --no-git-checks"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "i18next": "^25.8.1",
    "jose": "^6.1.3",
    "logform": "^2.7.0",
    "pg": "^8.18.0",
    "redis": "^5.10.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "packageManager": "pnpm@10.28.2"
}
